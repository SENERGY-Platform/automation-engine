diff --git b/engine_depth.go b/engine_depth.go
new file mode 100644
index 0000000..fc6f095
--- /dev/null
+++ b/engine_depth.go
@@ -0,0 +1,141 @@
+package goja
+
+import (
+	"github.com/dop251/goja/unistring"
+)
+
+func init() {
+	enginePatches = append(enginePatches, "native-depth")
+}
+
+// DefaultMaxNativeDepth bounds the recursion of goja's own Go code over values a script builds
+// unless SetMaxNativeDepth sets another bound. A level takes up to a few kilobytes of stack.
+const DefaultMaxNativeDepth = 10000
+
+// SetMaxNativeDepth bounds the recursion of goja's own Go code over values a script builds: a
+// native as an object's own toString, a nested array turned into text or JSON, a long prototype,
+// proxy or bound function chain, a yield* chain, a deep value exported to Go. SetMaxCallStackSize
+// counts JavaScript frames only, so that such a recursion overflowed the goroutine stack, a fatal
+// error that ends the process. Past the bound, the run ends with a *StackOverflowError, which a
+// script cannot catch; Export panics with it. Chains of proxies and bound functions longer than
+// the bound are refused when created, with a RangeError. Zero or less is DefaultMaxNativeDepth.
+func (r *Runtime) SetMaxNativeDepth(depth int) {
+	r.maxNativeDepth = depth
+}
+
+func (r *Runtime) nativeDepthLimit() int {
+	if r.maxNativeDepth <= 0 {
+		return DefaultMaxNativeDepth
+	}
+	return r.maxNativeDepth
+}
+
+// enterNative counts a level of native recursion; the caller defers leaveNative
+func (r *Runtime) enterNative() {
+	r.nativeDepth++
+	if r.nativeDepth > r.nativeDepthLimit() {
+		r.nativeDepth--
+		ex := &StackOverflowError{}
+		ex.stack = r.vm.captureStack(nil, 0)
+		panic(ex)
+	}
+}
+
+func (r *Runtime) leaveNative() {
+	r.nativeDepth--
+}
+
+// wrapperDepth is the length of the chain of proxies and bound functions an object starts, which
+// every operation on it follows natively; their targets cannot change, so that it is exact
+func wrapperDepth(o *Object) int {
+	switch w := o.self.(type) {
+	case *proxyObject:
+		return w.wrapperDepth
+	case *boundFuncObject:
+		return w.wrapperDepth
+	}
+	return 0
+}
+
+// nextWrapperDepth returns the depth of a proxy or bound function around target, and refuses a
+// chain longer than the bound
+func (r *Runtime) nextWrapperDepth(target *Object) int {
+	depth := wrapperDepth(target) + 1
+	if depth > r.nativeDepthLimit() {
+		panic(r.newErrorf(r.getRangeError(), "Maximum chain of %d proxies and bound functions exceeded", r.nativeDepthLimit()))
+	}
+	return depth
+}
+
+// The steps to a prototype, counted: a script can build a chain of millions of prototypes, which
+// every lookup, assignment and in check on it walks recursively.
+
+func protoGet(p *Object, name, receiver Value) Value {
+	r := p.runtime
+	r.enterNative()
+	defer r.leaveNative()
+	return p.get(name, receiver)
+}
+
+func protoGetStr(p *Object, name unistring.String, receiver Value) Value {
+	r := p.runtime
+	r.enterNative()
+	defer r.leaveNative()
+	return p.self.getStr(name, receiver)
+}
+
+func protoGetIdx(p *Object, idx valueInt, receiver Value) Value {
+	r := p.runtime
+	r.enterNative()
+	defer r.leaveNative()
+	return p.self.getIdx(idx, receiver)
+}
+
+func protoGetSym(p *Object, s *Symbol, receiver Value) Value {
+	r := p.runtime
+	r.enterNative()
+	defer r.leaveNative()
+	return p.self.getSym(s, receiver)
+}
+
+func protoSetForeignStr(p *Object, name unistring.String, val, receiver Value, throw bool) (bool, bool) {
+	r := p.runtime
+	r.enterNative()
+	defer r.leaveNative()
+	return p.self.setForeignStr(name, val, receiver, throw)
+}
+
+func protoSetForeignIdx(p *Object, idx valueInt, val, receiver Value, throw bool) (bool, bool) {
+	r := p.runtime
+	r.enterNative()
+	defer r.leaveNative()
+	return p.self.setForeignIdx(idx, val, receiver, throw)
+}
+
+func protoSetForeignSym(p *Object, s *Symbol, val, receiver Value, throw bool) (bool, bool) {
+	r := p.runtime
+	r.enterNative()
+	defer r.leaveNative()
+	return p.self.setForeignSym(s, val, receiver, throw)
+}
+
+func protoHasPropertyStr(p *Object, name unistring.String) bool {
+	r := p.runtime
+	r.enterNative()
+	defer r.leaveNative()
+	return p.self.hasPropertyStr(name)
+}
+
+func protoHasPropertyIdx(p *Object, idx valueInt) bool {
+	r := p.runtime
+	r.enterNative()
+	defer r.leaveNative()
+	return p.self.hasPropertyIdx(idx)
+}
+
+func protoHasPropertySym(p *Object, s *Symbol) bool {
+	r := p.runtime
+	r.enterNative()
+	defer r.leaveNative()
+	return p.self.hasPropertySym(s)
+}
diff --git b/engine_depth_test.go b/engine_depth_test.go
new file mode 100644
index 0000000..a754a97
--- /dev/null
+++ b/engine_depth_test.go
@@ -0,0 +1,85 @@
+package goja
+
+import (
+	"errors"
+	"os"
+	"os/exec"
+	"runtime/debug"
+	"strings"
+	"testing"
+)
+
+// shapes a script builds to make goja's own Go code recurse past the goroutine stack; each runs
+// with a stack cap of 64 MB, which they overflow by far without a bound on that recursion
+var nativeDepthShapes = map[string]string{
+	"native as own toString":          `var o = {}; o.toString = String.prototype.trim; String(o)`,
+	"native as own toPrimitive":       `var o = {}; o[Symbol.toPrimitive] = String.prototype.trim; String(o)`,
+	"error named by itself":           `var e = new Error(); e.name = e; String(e)`,
+	"nested array to string":          `var a = []; for (var i = 0; i < 300000; i++) a = [a]; String(a)`,
+	"nested array joined":             `var a = []; for (var i = 0; i < 300000; i++) a = [a]; a.join()`,
+	"nested array in template":        "var a = []; for (var i = 0; i < 300000; i++) a = [a]; `${a}`",
+	"nested array sorted":             `var a = []; for (var i = 0; i < 300000; i++) a = [a]; [a, []].sort()`,
+	"nested array toLocaleString":     `var a = []; for (var i = 0; i < 300000; i++) a = [a]; a.toLocaleString()`,
+	"nested array flat":               `var a = []; for (var i = 0; i < 1000000; i++) a = [a]; a.flat(Infinity)`,
+	"nested array stringified":        `var a = []; for (var i = 0; i < 300000; i++) a = [a]; JSON.stringify(a)`,
+	"yield* chain":                    `var it = (function* () { yield 1 })(); for (var i = 0; i < 300000; i++) it = (function* (inner) { yield* inner })(it); it.next()`,
+	"proxy chain set":                 `var p = {}; for (var i = 0; i < 500000; i++) p = new Proxy(p, {}); p.x = 1`,
+	"prototype chain set":             `var o = {}; for (var i = 0; i < 1500000; i++) o = Object.create(o); o.x = 1`,
+	"reviver injects a deep value":    `JSON.parse('{"a": 1, "b": 2}', function (k, v) { if (k === "a") { var d = {}; for (var i = 0; i < 1000000; i++) d = {d: d}; this.b = d } return v })`,
+	"deep object exported":            `var o = {}; for (var i = 0; i < 1500000; i++) o = {o: o}; o`,
+	"deep array exported":             `var a = []; for (var i = 0; i < 1500000; i++) a = [a]; a`,
+	"prototype chain get":             `var o = {}; for (var i = 0; i < 1500000; i++) o = Object.create(o); o.x`,
+	"prototype chain has":             `var o = {}; for (var i = 0; i < 1500000; i++) o = Object.create(o); "x" in o`,
+	"prototype chain index set":       `var o = {}; for (var i = 0; i < 1500000; i++) o = Object.create(o); o[1] = 1`,
+	"prototype chain symbol get":      `var o = {}; for (var i = 0; i < 1500000; i++) o = Object.create(o); o[Symbol.iterator]`,
+	"proxy chain get":                 `var p = {}; for (var i = 0; i < 500000; i++) p = new Proxy(p, {}); p.x`,
+	"proxy chain has":                 `var p = {}; for (var i = 0; i < 500000; i++) p = new Proxy(p, {}); "x" in p`,
+	"proxy chain delete":              `var p = {}; for (var i = 0; i < 500000; i++) p = new Proxy(p, {}); delete p.x`,
+	"proxy chain keys":                `var p = {}; for (var i = 0; i < 500000; i++) p = new Proxy(p, {}); Object.keys(p)`,
+	"proxy chain call":                `var f = function () {}; for (var i = 0; i < 500000; i++) f = new Proxy(f, {}); f()`,
+	"proxy chain isArray":             `var p = []; for (var i = 0; i < 500000; i++) p = new Proxy(p, {}); Array.isArray(p)`,
+	"proxy chain prototype":           `var p = {}; for (var i = 0; i < 500000; i++) p = new Proxy(p, {}); Object.getPrototypeOf(p)`,
+	"bound function chain call":       `var f = function () {}; for (var i = 0; i < 1000000; i++) f = f.bind(null); f()`,
+	"bound function chain instanceof": `var f = function () {}; for (var i = 0; i < 1000000; i++) f = f.bind(null); ({}) instanceof f`,
+	"bound function chain new":        `var f = function () {}; for (var i = 0; i < 1000000; i++) f = f.bind(null); new f()`,
+}
+
+// Every shape ends its run with a StackOverflowError instead of the process, or is refused when it
+// builds a chain of proxies or bound functions; the export of a deep result panics with one, which
+// the caller recovers from.
+func TestEngineNativeDepth(t *testing.T) {
+	if name := os.Getenv("GOJA_DEPTH_SHAPE"); name != "" {
+		debug.SetMaxStack(64 << 20)
+		vm := New()
+		value, err := vm.RunString(nativeDepthShapes[name])
+		if strings.HasSuffix(name, "exported") && err == nil {
+			err = func() (err error) {
+				defer func() {
+					if p := recover(); p != nil {
+						err, _ = p.(error)
+					}
+				}()
+				value.Export()
+				return nil
+			}()
+		}
+		var overflow *StackOverflowError
+		var exception *Exception
+		refused := errors.As(err, &exception) && strings.Contains(exception.Error(), "Maximum chain of 10000 proxies and bound functions exceeded")
+		if !errors.As(err, &overflow) && !refused {
+			t.Fatalf("expected a StackOverflowError or a refused chain, got %v", err)
+		}
+		return
+	}
+	for name := range nativeDepthShapes {
+		t.Run(name, func(t *testing.T) {
+			cmd := exec.Command(os.Args[0], "-test.run=^TestEngineNativeDepth$")
+			cmd.Env = append(os.Environ(), "GOJA_DEPTH_SHAPE="+name)
+			out, err := cmd.CombinedOutput()
+			if err != nil {
+				lines := strings.SplitN(string(out), "\n", 4)
+				t.Errorf("%v: %v", err, strings.Join(lines[:min(3, len(lines))], " | "))
+			}
+		})
+	}
+}
